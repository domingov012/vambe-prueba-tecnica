MONGO_URI=mongodb://localhost:27017
# Must match the database the enriched data lives in. Note config.py falls back
# to "vambe" if this is unset, which is not the name actually in use.
MONGO_DB_NAME=meetings

# "openrouter" or "google"
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Google Developer API (Gemini/Gemma direct) — used when LLM_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-4-31b-it

# Enrichment tuning. Four nested wall-clock ceilings, outermost last; each must
# be larger than the one above it (the app logs a warning at startup if not).
# Measured throughput is ~22s per transcript, so budget ~30s x LLM_BATCH_SIZE
# for the request timeout. Drop LLM_BATCH_SIZE before raising these.
# LLM_BATCH_SIZE=10
# LLM_REQUEST_TIMEOUT_SECONDS=300     # one HTTP request
# LLM_BATCH_TIMEOUT_SECONDS=660       # one enrich_batch() incl. its retries
# LLM_BATCH_MAX_STALL_SECONDS=1500    # one batch incl. stall re-attempts
# LLM_JOB_TIMEOUT_SECONDS=5400        # the whole job

# Default reasoning effort for enrichment calls: minimal | low | high. Unset
# sends no thinkingConfig (model default). The POST /api/ingestion/csv
# `thinking_level` query param overrides this per job.
# LLM_THINKING_LEVEL=minimal

# Constrain the enrichment response to the classification JSON schema (Google
# `responseJsonSchema`, OpenRouter `response_format`). On by default. Set false
# if a model/provider rejects the schema or you see batches truncate under it.
# LLM_STRUCTURED_OUTPUT=true

# DEBUG additionally logs every raw LLM response — useful when the model is
# returning JSON the parser rejects.
# LOG_LEVEL=INFO
