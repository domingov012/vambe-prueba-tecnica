MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=vambe

# "openrouter" or "google"
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Google Developer API (Gemini/Gemma direct) — used when LLM_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemma-4-31b-it

# Enrichment tuning. Drop LLM_BATCH_SIZE (transcripts per LLM call) if batches
# time out; LLM_REQUEST_TIMEOUT_SECONDS is the per-request HTTP timeout.
# LLM_BATCH_SIZE=10
# LLM_REQUEST_TIMEOUT_SECONDS=120
